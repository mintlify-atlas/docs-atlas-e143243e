  "keyFeatures": [
    "Interactive Textual TUI and non-interactive print mode",
    "Built-in coding tools: read, write, edit, and bash",
    "Durable JSONL sessions with resume, branching, and export",
    "Multi-provider support: OpenAI, Anthropic, Codex, GitHub Copilot, Hugging Face, OpenRouter, and local models",
    "Python extension API for custom tools, slash commands, hooks, and UI dialogs",
    "Project instructions from AGENTS.md, .tau/, and .agents/ resources",
    "User skills, prompt templates, and custom TUI themes",
    "Context accounting, manual/automatic compaction, and thinking-level controls",
    "Pi-compatible JSONL RPC mode for subprocess integration",
    "Three-layer architecture (tau_ai → tau_agent → tau_coding) for reuse and readability"
  ],
  "publicApiSurface": [
    "tau (CLI entry point)",
    "tau -p / --print (print mode)",
    "tau --mode [text|json|transcript|rpc]",
    "tau --session <id> (resume session)",
    "tau --model / --provider (model selection)",
    "tau --extension / -e (load extension)",
    "tau --system-prompt / --append-system-prompt",
    "tau --approve / --no-approve (project trust override)",
    "tau update / tau sessions / tau export / tau providers / tau setup",
    "AgentHarness (tau_agent library class)",
    "AgentHarnessConfig (tau_agent library class)",
    "AgentTool / AgentToolResult (tool definition types)",
    "ExtensionAPI.register_tool()",
    "ExtensionAPI.register_command()",
    "ExtensionAPI.on() (event subscription)",
    "ExtensionAPI.send_user_message()",
    "ExtensionAPI.send_custom_message()",
    "ExtensionAPI.register_message_renderer()",
    "ExtensionAPI.context (ExtensionContext)",
    "ExtensionAPI.set_inference_provider()",
    "~/.tau/catalog.toml (provider catalog overlay)",
